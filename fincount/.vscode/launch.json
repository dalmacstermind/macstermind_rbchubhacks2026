{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Back end (FastAPI, auto-reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["fincount_api.main:app", "--port", "8765", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": false
    },
    {
      "name": "App (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "runtimeExecutable": "${workspaceFolder}/app/node_modules/.bin/electron-vite",
      "windows": { "runtimeExecutable": "${workspaceFolder}/app/node_modules/.bin/electron-vite.cmd" },
      "runtimeArgs": ["dev", "--sourcemap"]
    }
  ],
  "compounds": [{ "name": "FinCount (both)", "configurations": ["Back end (FastAPI, auto-reload)", "App (Electron)"] }]
}
